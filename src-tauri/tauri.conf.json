{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnPawssant",
  "version": "0.1.3",
  "identifier": "com.jotrorox.enpawssant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EnPawssant",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "BoardGame",
    "shortDescription": "A cat-themed chess analysis app",
    "externalBin": ["binaries/stockfish"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NUJERjJFNjgxODE1MEMKUldRTUZSaG9MdDliTlNZcnNMSm5vMW1OSlpvMSthZ3hnL1l0WnNLWUNyUEhmdlAxQm4zU1RWVk8K",
      "endpoints": ["https://github.com/Jotrorox/enpawssant/releases/latest/download/latest.json"]
    }
  }
}
